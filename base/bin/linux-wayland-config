    if [ -f "$SHARED_DIR/terminal-fetch.sh" ]; then
        bash "$SHARED_DIR/terminal-fetch.sh" "$@"
    else
        echo -e "${RED}Erro: $SHARED_DIR/terminal-fetch.sh não encontrado.${NC}"
        exit 1
    fi
}
cmd_menu() {
    if [ -f "$SHARED_DIR/portal_menu.py" ]; then
        python3 "$SHARED_DIR/portal_menu.py" "$@"
    else
        echo -e "${RED}Erro: $SHARED_DIR/portal_menu.py não encontrado.${NC}"
        exit 1
    fi
}



# Despacha o comando pedido. Separado do roteamento para que o wrapper de log
# consiga executá-lo capturando a saída.
dispatch() {
    if [ $# -eq 0 ]; then
        if [ -t 0 ]; then
            cmd_menu
        else
            cmd_status
        fi
        return 0
    fi

    case "$1" in
        menu|portal) shift; cmd_menu "$@" ;;
        init|scan|profile) shift; cmd_init "$@" ;;
        setup|configure) shift; cmd_setup "$@" ;;
        status) cmd_status ;;
        fix-keyboard) cmd_fix_keyboard ;;
        patch-cedilla) shift; cmd_patch_cedilla "$@" ;;
        fix-tongfang) cmd_fix_tongfang ;;
        revert-tongfang) cmd_revert_tongfang ;;
        test-keyboard) cmd_test_keyboard ;;
        monitor-irq) cmd_monitor_irq ;;
        smart-keyboard-power) cmd_smart_keyboard_power "${2:-}" ;;
        smart-wifi-power|wifi-power) cmd_smart_wifi_power "${2:-}" ;;
        screen-hz|refresh-rate) shift; cmd_screen_hz "$@" ;;
        screen-60) cmd_screen_hz "60" ;;
        screen-120) cmd_screen_hz "120" ;;
        configure-harness) shift; cmd_configure_harness "$@" ;;
        set-lang|language) shift; cmd_set_lang "$@" ;;
        gestures) cmd_gestures ;;
        mouse) cmd_mouse ;;
        battery-status) cmd_battery_status ;;
        battery-apply) cmd_battery_apply ;;
        battery-revert) cmd_battery_revert "${2:-}" ;;
        preflight) cmd_preflight ;;
        turbo|cpu-turbo) shift; cmd_turbo "$@" ;;
        turbo-on) cmd_turbo "--on" ;;
        turbo-off) cmd_turbo "--off" ;;
        turbo-status) cmd_turbo "--status" ;;
        turbo-toggle) cmd_turbo "--toggle" ;;
        turbo-persist) cmd_turbo "--persist" ;;
        turbo-watch|watchdog) cmd_turbo "--watch" ;;
        switch) cmd_switch_layout "${2:-next}" ;;
        shortcut-switch) cmd_shortcut_switch ;;
        rollback) cmd_rollback ;;
        install) shift; cmd_install "$@" ;;
        report) cmd_report "${2:-}" ;;
        terminal-fetch|fetch-theme|cosmetic) shift; cmd_terminal_fetch "$@" ;;
        upgrade|update) cmd_upgrade "${2:---apply}" ;;
        help|--help|-h) usage ;;
        *) echo -e "${RED}Unknown command: $1${NC}"; usage; exit 1 ;;
    esac
}

# -----------------------------------------------------------------------------
# Roteamento com registro de execução
#
# Cada execução vira um run em ~/.local/state/kde-wayland-suite/runs/, com os
# eventos estruturados que os scripts emitem, a saída bruta sem cores e um
# meta.env. É isso que o comando 'report' lê depois — o relatório sai dos dados,
# não do texto colorido, que mudaria a cada ajuste de redação.
#
# 'report' e 'help' não são registrados: são leitura pura e só poluiriam o
# histórico com runs sem valor.
# -----------------------------------------------------------------------------
COMMAND_NAME="${1:-status}"

if [ -f "$SHARED_DIR/lib-runlog.sh" ] && [ "$COMMAND_NAME" != "report" ] \
   && [ "$COMMAND_NAME" != "help" ] && [ "$COMMAND_NAME" != "--help" ] && [ "$COMMAND_NAME" != "-h" ]; then
    # shellcheck source=../shared/lib-runlog.sh
    source "$SHARED_DIR/lib-runlog.sh"
    RUNLOG_COMMAND="$COMMAND_NAME"
    RUNLOG_SUITE_VERSION="$(grep -oP '(?<="version": ")[^"]+' "$BASE_DIR/../../.claude-plugin/plugin.json" 2>/dev/null | head -1 || echo 'desconhecida')"
    export RUNLOG_COMMAND RUNLOG_SUITE_VERSION
    runlog_init "$COMMAND_NAME"
fi

if [ -n "${RUNLOG_DIR:-}" ]; then
    # Espelha a saída no terminal e, sem as cores ANSI, no output.log.
    # 'set -o pipefail' garante que o código de saída seja o do dispatch, não o
    # do tee — do contrário todo comando pareceria ter sucesso.
    set -o pipefail
    # O '|| DISPATCH_RC=$?' é obrigatório: este script roda com 'set -e', então
    # um pipeline que falha encerraria o processo AQUI, antes do runlog_finish —
    # e a execução que falhou (justamente a que mais interessa registrar) ficaria
    # sem meta.env. Com o '||', a falha é capturada em vez de abortar.
    DISPATCH_RC=0
    dispatch "$@" 2>&1 | tee >(sed -u 's/\x1b\[[0-9;]*m//g' > "$RUNLOG_DIR/output.log") || DISPATCH_RC=$?
    runlog_finish "$DISPATCH_RC"
    exit "$DISPATCH_RC"
else
    dispatch "$@"
fi
