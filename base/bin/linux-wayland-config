    if [ -f "$SHARED_DIR/upgrade-suite.sh" ]; then
        bash "$SHARED_DIR/upgrade-suite.sh" "${1:---status}"
    else
        echo -e "${RED}Error: $SHARED_DIR/upgrade-suite.sh not found.${NC}"
        exit 1
    fi
}




cmd_scan() {
    cmd_init "$@"
}

cmd_init() {
    echo -e "${BOLD}${BLUE}======================================================${NC}"
    echo -e "${BOLD}${BLUE}   Linux Wayland Suite — Initialization & Profiling   ${NC}"
    echo -e "${BOLD}${BLUE}======================================================${NC}\n"

    local lang="${KDE_SUITE_LANG:-${LINUX_WAYLAND_SUITE_LANG:-}}"
    if [ -n "$lang" ]; then
        cmd_set_lang "$lang"
        echo ""
    fi

    cmd_preflight
    echo ""

    if [ -f "$SHARED_DIR/profile-machine.sh" ]; then
        bash "$SHARED_DIR/profile-machine.sh"
    else
        echo -e "${RED}Erro: $SHARED_DIR/profile-machine.sh não encontrado.${NC}"
        exit 1
    fi

    cmd_install
    echo ""

    if [ "${1:-}" = "--setup" ] || [ "${SETUP:-0}" = "1" ] || [ "${INIT_RUN_SETUP:-0}" = "1" ]; then
        [ "${1:-}" = "--setup" ] && shift
        echo ""
        cmd_setup "$@"
    fi
}

cmd_setup() {
    if [ -f "$SHARED_DIR/setup-suite.py" ]; then
        python3 "$SHARED_DIR/setup-suite.py" "$@"
    elif [ -f "$SHARED_DIR/setup-suite.sh" ]; then
        bash "$SHARED_DIR/setup-suite.sh" "$@"
    else
        echo -e "${RED}Erro: $SHARED_DIR/setup-suite.py não encontrado.${NC}"
        exit 1
    fi
}

