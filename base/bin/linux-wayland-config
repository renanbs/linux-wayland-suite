        bash "$SHARED_DIR/manage-wifi-power.sh" "${1:---status}"
    else
        echo -e "${RED}Erro: $SHARED_DIR/manage-wifi-power.sh não encontrado.${NC}"
        exit 1
    fi
}

cmd_screen_hz() {
    local target="${1:-}"
    if [ -f "$SHARED_DIR/lib-battery-gpu.sh" ]; then
        # shellcheck source=lib-battery-gpu.sh
        source "$SHARED_DIR/lib-battery-gpu.sh"
    fi

    read -r EDP_OUT_NAME EDP_CUR_HZ EDP_CUR_MODE_ID EDP_60_ID EDP_HIGH_ID <<< "$(find_edp_refresh_modes || true)"

    if [ -z "$EDP_OUT_NAME" ] || [ "$EDP_OUT_NAME" = "unknown" ]; then
        echo -e "${RED}Erro: Nenhuma tela interna (eDP) detectada via kscreen-doctor.${NC}"
        exit 1
    fi

    case "$target" in
        60)
            if [ -z "$EDP_60_ID" ] || [ "$EDP_60_ID" = "none" ]; then
                echo -e "${RED}Erro: Nenhum modo de 60 Hz disponível para a tela $EDP_OUT_NAME.${NC}"
                exit 1
            fi
            if set_edp_mode "$EDP_OUT_NAME" "$EDP_60_ID"; then
                echo -e "${GREEN}✔ Taxa de atualização da tela $EDP_OUT_NAME alternada para 60 Hz (modo $EDP_60_ID).${NC}"
            else
                echo -e "${YELLOW}⚠️ O driver gráfico rejeitou o modo 60 Hz para $EDP_OUT_NAME (painel com taxa nativa fixa). Mantida taxa de ${EDP_CUR_HZ} Hz.${NC}"
            fi
            ;;
        120|max|high)
            if [ -z "$EDP_HIGH_ID" ] || [ "$EDP_HIGH_ID" = "none" ]; then
                echo -e "${RED}Erro: Nenhum modo de alta taxa disponível para a tela $EDP_OUT_NAME.${NC}"
                exit 1
            fi
            if set_edp_mode "$EDP_OUT_NAME" "$EDP_HIGH_ID"; then
                echo -e "${GREEN}✔ Taxa de atualização da tela $EDP_OUT_NAME alternada para alta taxa (modo $EDP_HIGH_ID).${NC}"
            else
                echo -e "${YELLOW}⚠️ O driver gráfico rejeitou a alteração para alta taxa.${NC}"
            fi
            ;;
        "")
            echo -e "${BOLD}Tela Interna:${NC} $EDP_OUT_NAME"
            echo -e "  • Taxa atual: ${BOLD}${EDP_CUR_HZ} Hz${NC} (Modo ID: $EDP_CUR_MODE_ID)"
            [ -n "$EDP_60_ID" ] && [ "$EDP_60_ID" != "none" ] && echo -e "  • Modo 60 Hz disponível: Modo ID $EDP_60_ID"
            [ -n "$EDP_HIGH_ID" ] && [ "$EDP_HIGH_ID" != "none" ] && echo -e "  • Modo Alta Taxa disponível: Modo ID $EDP_HIGH_ID"
            echo ""
            echo "Use 'linux-wayland-config screen-hz 60' ou 'linux-wayland-config screen-hz 120' para alternar."
            ;;
        *)
            echo -e "${RED}Opção inválida: '$target'. Use '60', '120' ou 'max'.${NC}"
            exit 1
            ;;
    esac
}
cmd_switch_layout() {
    local target="${1:-next}"
    if [ -z "$QDBUS" ]; then
        echo -e "${RED}Error: qdbus6/qdbus not found in PATH.${NC}"
        exit 1
    fi
    
    case "$target" in
        br|0)
            "$QDBUS" org.kde.keyboard /Layouts org.kde.KeyboardLayouts.setLayout 0
            echo -e "${GREEN}✔ Layout switched to: Portuguese (Brazil) - ABNT2 (0)${NC}"
            ;;
        us|1)
            "$QDBUS" org.kde.keyboard /Layouts org.kde.KeyboardLayouts.setLayout 1
            echo -e "${GREEN}✔ Layout switched to: English (US, alt-intl) (1)${NC}"
            ;;
        next)
            "$QDBUS" org.kde.keyboard /Layouts org.kde.KeyboardLayouts.switchToNextLayout
            local cur
            cur="$("$QDBUS" org.kde.keyboard /Layouts org.kde.KeyboardLayouts.getLayout 2>/dev/null || echo '?')"
            echo -e "${GREEN}✔ Layout switched to next (index $cur).${NC}"
            ;;
        *)
            echo -e "${RED}Invalid option: '$target'. Use 'br', 'us' or 'next'.${NC}"
            exit 1
            ;;
    esac
}

cmd_shortcut_switch() {
    echo "==> Configuring global Meta+Space shortcut to switch layouts..."
    kwriteconfig6 --file kglobalshortcutsrc --group "KDE Keyboard Layout Switcher" --key "Switch to Next Keyboard Layout" "Meta+Space,Meta+Space,Switch to Next Keyboard Layout" --notify
    echo -e "${GREEN}✔ Meta+Space shortcut configured in KWin successfully.${NC}"
}

cmd_rollback() {
    echo -e "${BOLD}==> Searching for backup snapshots in ~/.config/kde-config-backups/...${NC}"
    local backup_root="$HOME/.config/kde-config-backups"
    if [ ! -d "$backup_root" ]; then
        echo "No backup directory found in $backup_root."
        exit 1
    fi
    
    local latest
    latest="$(ls -td "$backup_root"/*/ 2>/dev/null | head -n 1 || true)"
    if [ -z "$latest" ]; then
        echo "No backup snapshot found."
        exit 1
    fi
    
    echo "Restoring snapshot: $latest"
    if [ -f "$latest/.config/kxkbrc" ] || [ -f "$latest/kxkbrc" ]; then
        local src="${latest}/.config/kxkbrc"
        [ -f "$src" ] || src="${latest}/kxkbrc"
        cp "$src" "$HOME/.config/kxkbrc"
        kwriteconfig6 --file kxkbrc --group Layout --key Use true --notify
        echo "  [OK] kxkbrc restored."
    fi
    if [ -f "$latest/.XCompose" ] || [ -f "$latest/XCompose" ]; then
        local src="${latest}/.XCompose"
        [ -f "$src" ] || src="${latest}/XCompose"
        cp "$src" "$HOME/.XCompose"
        echo "  [OK] ~/.XCompose restored."
    fi
    if [ -f "$latest/.config/environment.d/im.conf" ] || [ -f "$latest/im.conf" ]; then
        local src="${latest}/.config/environment.d/im.conf"
        [ -f "$src" ] || src="${latest}/im.conf"
        cp "$src" "$HOME/.config/environment.d/im.conf"
        echo "  [OK] im.conf restored."
    fi
    if [ -f "$latest/.config/environment.d/cedilla.conf" ]; then
        cp "$latest/.config/environment.d/cedilla.conf" "$HOME/.config/environment.d/cedilla.conf"
        echo "  [OK] cedilla.conf restored."
    fi
    if [ -f "$latest/.config/fish/conf.d/cedilla.fish" ]; then
        cp "$latest/.config/fish/conf.d/cedilla.fish" "$HOME/.config/fish/conf.d/cedilla.fish"
        echo "  [OK] cedilla.fish restored."
    fi
    
    for f in chrome-flags.conf chromium-flags.conf electron-flags.conf code-flags.conf orca-flags.conf; do
        if [ -f "$latest/.config/$f" ]; then
            cp "$latest/.config/$f" "$HOME/.config/$f"
            echo "  [OK] ~/.config/$f restored."
        fi
    done
    
    echo -e "${GREEN}✔ Snapshot restored successfully.${NC}"
}

cmd_install() {
    local mode="${1:-standalone}"
    mkdir -p "$HOME/.local/bin"

    if [ "$mode" = "--link" ] || [ "$mode" = "--dev" ]; then
        local script_path
        script_path="$(realpath "${BASH_SOURCE[0]}")"
        chmod +x "$script_path"
        for name in linux-wayland-config kde-config wayland-config; do
            ln -sf "$script_path" "$HOME/.local/bin/$name"
            echo -e "${GREEN}✔ Symlink de desenvolvimento criado: $HOME/.local/bin/$name -> $script_path${NC}"
        done
        echo "Modo de desenvolvimento ativado (apontando diretamente para a worktree local)."
        return 0
    fi

    # Instalação permanente independente de worktree
    local dest_dir="$HOME/.local/share/linux-wayland-suite"
    echo -e "${BOLD}==> Instalando linux-wayland-suite de forma permanente em $dest_dir...${NC}"
    rm -rf "$dest_dir/bin" "$dest_dir/shared" "$dest_dir/commands"
    mkdir -p "$dest_dir/bin" "$dest_dir/shared" "$dest_dir/commands"

    # Copia arquivos canônicos
    local bin_src="$BASE_DIR"
    local shared_src="$SHARED_DIR"
    local commands_src="$(realpath "$BASE_DIR/../commands" 2>/dev/null || echo "")"

    cp -a "$bin_src/"* "$dest_dir/bin/"
    cp -a "$shared_src/"* "$dest_dir/shared/"
    if [ -n "$commands_src" ] && [ -d "$commands_src" ]; then
        cp -a "$commands_src/"* "$dest_dir/commands/"
    fi
    chmod +x "$dest_dir/bin/"* "$dest_dir/shared/"*.sh "$dest_dir/shared/"*.py 2>/dev/null || true

    local target_bin="$dest_dir/bin/linux-wayland-config"
    for name in linux-wayland-config kde-config wayland-config; do
        ln -sf "$target_bin" "$HOME/.local/bin/$name"
        echo -e "${GREEN}✔ Instalado: $HOME/.local/bin/$name -> $target_bin${NC}"
    done

    # Se /usr/local/bin for gravável diretamente pelo usuário
    if [ -w "/usr/local/bin" ]; then
        for name in linux-wayland-config kde-config wayland-config; do
            ln -sf "$target_bin" "/usr/local/bin/$name" 2>/dev/null || true
        done
    fi

    # -------------------------------------------------------------------------
    # Configuração de PATH nos shells do usuário (Fish, Bash, Zsh, Wayland/PAM)
    # -------------------------------------------------------------------------
    mkdir -p "$HOME/.config/environment.d"
    local env_path_conf="$HOME/.config/environment.d/10-local-bin.conf"
    if [ ! -f "$env_path_conf" ] || ! grep -q "local/bin" "$env_path_conf" 2>/dev/null; then
        echo 'PATH=$HOME/.local/bin:$PATH' > "$env_path_conf"
        echo -e "${GREEN}✔ Configurado environment.d: $env_path_conf (persistência Wayland/PAM)${NC}"
    fi

    # Fish Shell
    if command -v fish >/dev/null 2>&1 || [ -d "$HOME/.config/fish" ]; then
        mkdir -p "$HOME/.config/fish/conf.d"
        local fish_path_conf="$HOME/.config/fish/conf.d/linux-wayland-suite-path.fish"
        cat << 'EOF' > "$fish_path_conf"
# Linux Wayland Suite — Garante ~/.local/bin no PATH do Fish
if test -d "$HOME/.local/bin"
    fish_add_path -g $HOME/.local/bin
end
EOF
        echo -e "${GREEN}✔ Configurado Fish Shell: $fish_path_conf${NC}"
    fi

    # Bash
    if [ -f "$HOME/.bashrc" ] && ! grep -q "local/bin" "$HOME/.bashrc" 2>/dev/null; then
        echo '[[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
        echo -e "${GREEN}✔ Configurado Bash: ~/.bashrc${NC}"
    fi

    # Zsh
    if [ -f "$HOME/.zshrc" ] && ! grep -q "local/bin" "$HOME/.zshrc" 2>/dev/null; then
        echo '[[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.zshrc"
        echo -e "${GREEN}✔ Configurado Zsh: ~/.zshrc${NC}"
    fi

    echo ""
    echo -e "${GREEN}✔ Instalação permanente concluída com sucesso!${NC}"
    echo -e "Comandos disponíveis em qualquer terminal/diretório:"
    echo -e "  • ${BOLD}linux-wayland-config${NC} (ou ${BOLD}kde-config${NC})"
    echo -e "  • ${BOLD}linux-wayland-config status${NC}"
    echo -e "  • ${BOLD}linux-wayland-config turbo${NC}"
    echo -e "  • ${BOLD}linux-wayland-config menu${NC}"
}
