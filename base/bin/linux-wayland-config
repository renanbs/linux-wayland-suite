#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# kde-config — Unified CLI Orchestrator for KDE Plasma 6 Wayland
# Manages keyboard (ABNT2/US-intl/Ctrl+C), cedilla, gestures, power and shortcuts
# ==============================================================================

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'
SCRIPT_REALPATH="$(realpath "${BASH_SOURCE[0]}")"
BASE_DIR="$(dirname "$SCRIPT_REALPATH")"

if [ -d "$BASE_DIR/../shared" ]; then
    SHARED_DIR="$(realpath "$BASE_DIR/../shared")"
elif [ -d "$BASE_DIR/shared" ]; then
    SHARED_DIR="$(realpath "$BASE_DIR/shared")"
elif [ -d "$BASE_DIR/../scripts" ]; then
    SHARED_DIR="$(realpath "$BASE_DIR/../scripts")"
elif [ -d "$BASE_DIR/scripts" ]; then
    SHARED_DIR="$(realpath "$BASE_DIR/scripts")"
else
    SHARED_DIR="$BASE_DIR/../shared"
fi
# Detecção dinâmica de D-Bus
if command -v qdbus6 >/dev/null 2>&1; then
    QDBUS="qdbus6"
elif command -v qdbus >/dev/null 2>&1; then
    QDBUS="qdbus"
elif [ -x /usr/lib/qt6/bin/qdbus ]; then
    QDBUS="/usr/lib/qt6/bin/qdbus"
else
    QDBUS=""
fi

usage() {
    echo -e "${BOLD}Usage:${NC} linux-wayland-config <command> [arguments]"
    echo ""
    echo -e "${BOLD}Available commands:${NC}"
    echo "  menu              Interactive management portal with real-time status summary"
    echo "  init / scan       Hardware inspection and machine profiling (safe, non-destructive)"
    echo "  setup             Contextual modular configuration wizard based on detected hardware"
    echo "  status            Unified health audit (keyboard, cedilla, shortcuts, gestures, battery, wifi)"
    echo "  fix-keyboard      Fixes Ctrl+C on ABNT2, native cedilla on US-intl and masks fcitx5"
    echo "  patch-cedilla [--apply|--revert|--status]  Fixes '+c -> ç in Chromium/Electron (Chrome, Orca, VS Code, Discord, Brave)"
    echo "  gestures          Installs and configures 3/4-finger touchpad gestures (libinput-gestures)"
    echo "  mouse             Installs and configures Logitech MX Master 3S (logiops/logid)"
    echo "  battery-status    Battery and power consumption diagnostics (GPU, PCIe ASPM, health)"
    echo "  battery-apply     Applies user-chosen battery optimizations (BATTERY_FIX_*)"
    echo "  battery-revert    Reverts the last battery-apply execution (or specific snapshot)"
    echo "  turbo [on|off|status|toggle|persist|watch]  CPU Turbo Boost & thermal management"
    echo "  smart-wifi-power  Dynamic Wi-Fi power management (AC vs Battery) (--apply/--remove/--sync/--status)"
    echo "  screen-hz [60|120|max]  Switches internal display refresh rate (60 Hz vs 120 Hz)"
    echo "  fix-tongfang      Unlocks i8042 keyboard matrix in GRUB for Tongfang/Avell laptops"
    echo "  revert-tongfang   Reverts GRUB configuration to previous backup"
    echo "  test-keyboard     Interactive real-time key event monitor (/dev/input/eventX)"
    echo "  monitor-irq       Hardware electric pulse monitor on IRQ 1 (i8042 keyboard)"
    echo "  smart-keyboard-power  Dynamic keyboard power management (--apply/--remove/--status)"
    echo "  configure-harness Configures AI host harness profile and model roles"
    echo "  set-lang [en|pt-BR]  Saves language preference (en / pt-BR)"
    echo "  preflight         Environment diagnostic (distro, D-Bus, tools)"
    echo "  switch [br|us]    Switches active KWin keyboard layout (0=br, 1=us)"
    echo "  shortcut-switch   Configures Meta+Space shortcut to switch layouts in KWin"
    echo "  rollback          Restores previous configuration snapshots from backup"
    echo "  report            Run report from structured events + historical trends"
    echo "                    (report <n> shows N-th latest; report --list lists runs)"
    echo "  upgrade / update  Checks and applies repository and marketplace updates"
    echo "  install [--standalone|--dev]  Installs suite permanently to ~/.local/share (or links for dev)"
    echo "  help              Displays this help manual"
    echo "  terminal-fetch    Cosmetic Fastfetch/terminal identity menu and logo switch (alias: cosmetic)"
    echo ""
    echo -e "${BOLD}Environment variables (init / setup / fix-keyboard / battery):${NC}"
    echo "  KDE_SUITE_LANG=en|pt-BR      Sets language preference during init (default: en)"
    echo "  SETUP=1                      Runs setup wizard immediately after init/scan"
    echo "  KDE_SUITE_LAYOUT_AUTOHEAL=1  Installs autostart to heal collapsed layout on login"
    echo "  BATTERY_FIX_GPU_PRIMARY=1        (battery-apply) Reorders KWIN_DRM_DEVICES: internal panel GPU primary"
    echo "  BATTERY_FIX_PCIE_ASPM=1          (battery-apply) Sets PCIe ASPM powersave policy"
    echo "  BATTERY_FIX_PCIE_ASPM_PERSIST=1  (battery-apply) Persists ASPM policy across reboot (systemd service)"
    echo ""
}
cmd_status() {
    if [ -f "$SHARED_DIR/check-status.py" ]; then
        python3 "$SHARED_DIR/check-status.py" "$@"
    elif [ -f "$SHARED_DIR/check-status.sh" ]; then
        bash "$SHARED_DIR/check-status.sh" "$@"
    else
        echo -e "${RED}Erro: $SHARED_DIR/check-status.py não encontrado.${NC}"
        exit 1
    fi
}

cmd_fix_keyboard() {
    if [ -f "$SHARED_DIR/fix-keyboard.sh" ]; then
        bash "$SHARED_DIR/fix-keyboard.sh"
    else
        echo -e "${RED}Erro: $SHARED_DIR/fix-keyboard.sh não encontrado.${NC}"
        exit 1
    fi
}
